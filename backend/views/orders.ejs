<%- include('partials/header', { title, navActive: '' }) %>
<%- include('partials/flash') %>

<main class="product-page">
  <h1 style="font-size:40px;margin-bottom:24px">My Orders</h1>

  <% if (orders.length === 0) { %>
    <p style="color:var(--muted)">You haven't placed any orders yet. <a href="/" style="color:var(--green)">Start shopping →</a></p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Order #</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td>#<%= o.order_id %></td>
            <td><%= fmtDate(o.order_date) %></td>
            <td><%= o.item_count %></td>
            <td>$<%= o.total ? parseFloat(o.total).toFixed(2) : '0.00' %></td>
            <td>
              <span class="pill <%= o.order_status === 'Pending' || o.order_status === 'Cancelled' ? 'warn' : '' %>">
                <%= o.order_status %>
              </span>
            </td>
            <td><a href="/orders/<%= o.order_id %>" style="color:var(--green)">View →</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
