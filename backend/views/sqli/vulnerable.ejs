<%- include('../partials/header', { title, navActive: '' }) %>

<main class="product-page">
  <div style="max-width:800px;margin:0 auto">

    <div style="background:var(--amber-soft);border-left:4px solid var(--amber);padding:12px 18px;border-radius:8px;margin-bottom:20px">
      <strong style="color:var(--amber)">⚠ INTENTIONALLY VULNERABLE — Educational Demo Only</strong><br>
      <span style="font-size:13px;color:var(--text)">
        This route concatenates user input directly into SQL. It is running as a read-only account so no data can be modified, but it demonstrates how injection works.
      </span>
    </div>

    <div style="display:flex;align-items:baseline;gap:16px;margin-bottom:4px">
      <h1 style="font-size:36px">Order Lookup</h1>
      <span style="color:var(--amber);font-size:14px;font-weight:700">VULNERABLE VERSION</span>
    </div>
    <p style="color:var(--muted);margin-bottom:20px">
      <a href="/sqli" style="color:var(--green)">← Demo home</a> &nbsp;|&nbsp;
      <a href="/sqli/safe" style="color:var(--green)">Switch to safe version →</a>
    </p>

    <form action="/sqli/vulnerable" method="post" style="background:var(--surface);border-radius:var(--radius);padding:24px;margin-bottom:24px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
        <label style="display:grid;gap:4px;font-size:14px;color:var(--muted)">
          Email
          <input type="text" name="email" value="<%= email %>"
                 placeholder="e.g. olivia.martinez@example.com' #"
                 style="padding:10px 12px;border:1px solid var(--line);border-radius:8px">
        </label>
        <label style="display:grid;gap:4px;font-size:14px;color:var(--muted)">
          Phone Number
          <input type="text" name="phone" value="<%= phone %>"
                 placeholder="e.g. (214) 848-7138"
                 style="padding:10px 12px;border:1px solid var(--line);border-radius:8px">
        </label>
      </div>
      <button class="btn" style="background:var(--amber)" type="submit">Look Up Orders</button>
    </form>

    <% if (executedSQL !== null) { %>
      <div style="margin-bottom:24px">
        <h2 style="font-size:18px;margin-bottom:8px;color:var(--amber)">Executed SQL</h2>
        <pre style="background:#2b2b26;color:#e6ece0;padding:16px;border-radius:8px;overflow-x:auto;font-size:13px;white-space:pre-wrap"><%= executedSQL %></pre>
      </div>

      <% if (dbError) { %>
        <div style="background:var(--amber-soft);padding:12px 16px;border-radius:8px;color:var(--amber)">
          <strong>Database Error:</strong> <%= dbError %>
        </div>
      <% } else if (results.length === 0) { %>
        <p style="color:var(--muted)">No orders found for those credentials.</p>
      <% } else { %>
        <h2 style="font-size:18px;margin-bottom:12px">
          Results — <strong style="color:<%= results.length > 1 ? 'var(--amber)' : 'var(--green)' %>"><%= results.length %> row(s) returned</strong>
        </h2>
        <table>
          <thead>
            <tr><th>Order</th><th>Customer</th><th>Email</th><th>Phone</th><th>Date</th><th>Status</th><th>Items</th><th>Total</th></tr>
          </thead>
          <tbody>
            <% results.forEach(r => { %>
              <tr>
                <td>#<%= r.order_id %></td>
                <td><%= r.user_name %></td>
                <td class="email"><%= r.email %></td>
                <td><%= r.phone_no %></td>
                <td><%= r.order_date %></td>
                <td><span class="pill"><%= r.order_status %></span></td>
                <td><%= r.item_count %></td>
                <td>$<%= r.total ? parseFloat(r.total).toFixed(2) : '0.00' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    <% } %>
  </div>
</main>

</body>
</html>
