<%- include('../partials/header', { title, navActive: '' }) %>
<%- include('_style') %>

<main class="product-page">
  <div class="sqli">
    <h1>SQL Injection Demo</h1>
    <p class="lede">Order lookup by email + phone. Flip the switch to compare the vulnerable and the prepared-statement version of the same query.</p>

    <form id="lookup" action="/sqli" method="post" class="card">
      <label class="toggle <%= prepared ? 'on' : '' %>">
        <input type="checkbox" name="prepared" <%= prepared ? 'checked' : '' %>>
        <span class="track"><span class="knob"></span></span>
        <span>Prepared statements <strong class="state"><%= prepared ? 'ON' : 'OFF' %></strong></span>
        <code class="how"><%= prepared ? 'sqliPool.execute(sql, [email, phone])' : 'sqliPool.query("... \'" + email + "\' ...")' %></code>
      </label>

      <div class="chips">
        <% payloads.forEach(p => { %>
          <button type="button" class="chip-btn" data-email="<%= p.email %>" data-phone="<%= p.phone %>"><%= p.label %></button>
        <% }) %>
      </div>
      <div class="fields">
        <label>Email <input type="text" name="email" value="<%= email %>" autocomplete="off" spellcheck="false"></label>
        <label>Phone <input type="text" name="phone" value="<%= phone %>" autocomplete="off" spellcheck="false"></label>
      </div>
      <button class="btn <%= prepared ? '' : 'amber' %>" type="submit">Look Up Orders</button>
    </form>

    <% if (segments) { %>
      <div class="card">
        <h2 style="font-size:18px"><%= prepared ? 'SQL sent to MySQL (fixed, values sent separately)' : 'SQL that MySQL ran' %></h2>
        <pre class="sql"><% segments.forEach(s => { %><% if (s.kind === 'sql') { %><%= s.text %><% } else { %><span class="<%= s.kind %>"><%= s.text %></span><% } %><% }) %></pre>
        <% if (prepared) { %>
          <p class="bound">Values: email = <code><%= email %></code>, phone = <code><%= phone %></code></p>
        <% } else { %>
          <p class="bound"><span style="background:#9a6a1f;color:#fff;padding:0 4px;border-radius:3px">highlighted</span> = your input &nbsp;·&nbsp; <span style="color:#8a877c;text-decoration:line-through">struck out</span> = commented out by <code>#</code></p>
        <% } %>
      </div>

      <div class="card">
        <% if (dbError) { %>
          <div class="err"><strong>Database error:</strong> <%= dbError %></div>
        <% } else { %>
          <p class="count <%= results.length === 0 ? 'none' : (results.length > 7 ? 'many' : '') %>">
            <strong><%= results.length %></strong> row<%= results.length === 1 ? '' : 's' %> returned
          </p>
          <% if (results.length) { %>
            <table>
              <thead><tr><th>Order</th><th>Customer</th><th>Email</th><th>Phone</th><th>Date</th><th>Status</th><th>Items</th><th>Total</th></tr></thead>
              <tbody>
                <% results.forEach(r => { %>
                  <tr>
                    <td>#<%= r.order_id %></td>
                    <td><%= r.user_name %></td>
                    <td class="email"><%= r.email %></td>
                    <td><%= r.phone_no %></td>
                    <td><%= r.order_date %></td>
                    <td><span class="pill"><%= r.order_status %></span></td>
                    <td><%= r.item_count %></td>
                    <td>$<%= r.total ? parseFloat(r.total).toFixed(2) : '0.00' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        <% } %>
      </div>
    <% } %>
  </div>
</main>

<script>
  const f = document.getElementById('lookup');
  // One click: fill both fields with the payload and run it.
  document.querySelectorAll('.chip-btn').forEach(b => b.addEventListener('click', () => {
    f.email.value = b.dataset.email;
    f.phone.value = b.dataset.phone;
    f.submit();
  }));
  // Flipping the switch re-runs the same input, so the two versions compare instantly.
  f.prepared.addEventListener('change', () => {
    if (f.email.value || f.phone.value) f.submit();
    else location.href = f.prepared.checked ? '/sqli?prepared=on' : '/sqli';
  });
</script>

</body>
</html>
