<style>
  .sqli { max-width: 900px; margin: 0 auto; }
  .sqli h1 { font-size: 38px; margin-bottom: 6px; }
  .sqli .lede { color: var(--muted); margin-bottom: 24px; }
  .sqli .tag { font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
  .sqli .tag.vuln { color: var(--amber); }
  .sqli .tag.safe { color: var(--green); }
  .sqli .card { background: var(--surface); border-radius: var(--radius); padding: 20px 22px; margin-bottom: 20px; }
  .sqli .routes { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
  .sqli .route { display: block; background: var(--surface); border-radius: var(--radius); padding: 20px 22px; border: 2px solid var(--line); }
  .sqli .route.vuln { border-color: var(--amber); }
  .sqli .route.safe { border-color: var(--green); }
  .sqli .route h2 { font-size: 22px; margin: 4px 0 8px; }
  .sqli code, .sqli pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
  .sqli .route code { display: block; background: var(--soft); padding: 8px 10px; border-radius: 6px; }
  .sqli table code { background: var(--soft); padding: 2px 6px; border-radius: 4px; white-space: nowrap; }
  .sqli .runs { display: flex; gap: 8px; flex-wrap: wrap; }
  .sqli .runs form { margin: 0; }
  .sqli .btn.sm { padding: 6px 12px; font-size: 13px; }
  .sqli .btn.amber { background: var(--amber); }
  .sqli .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .sqli .chip-btn { border: 1px solid var(--line); background: var(--soft); border-radius: 999px; padding: 7px 14px; font-size: 13px; cursor: pointer; color: var(--text); }
  .sqli .chip-btn:hover { border-color: var(--green); }
  .sqli .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
  .sqli .fields label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .sqli .fields input { padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font-family: ui-monospace, Menlo, monospace; font-size: 14px; }
  .sqli .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .sqli .btn.ghost { background: transparent; color: var(--green); border: 1px solid var(--green); }
  .sqli pre.sql { background: #2b2b26; color: #e6ece0; padding: 16px; border-radius: 8px; white-space: pre-wrap; line-height: 1.5; margin: 8px 0 0; }
  .sqli pre.sql .input { background: #9a6a1f; color: #fff; border-radius: 3px; padding: 0 2px; }
  .sqli pre.sql .comment { color: #8a877c; text-decoration: line-through; }
  .sqli .bound { margin-top: 10px; font-size: 14px; }
  .sqli .bound code { background: var(--green-soft); padding: 2px 6px; border-radius: 4px; }
  .sqli .count { font-size: 20px; margin: 4px 0 12px; }
  .sqli .count.many { color: var(--amber); }
  .sqli .count.none { color: var(--green); }
  .sqli .err { background: var(--amber-soft); padding: 12px 16px; border-radius: 8px; color: var(--amber); }
  .sqli pre.sql .param { background: #5c7353; color: #fff; border-radius: 3px; padding: 0 3px; }
  .sqli .toggle { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; cursor: pointer; margin-bottom: 18px; font-size: 16px; }
  .sqli .toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
  .sqli .toggle .track { width: 52px; height: 28px; border-radius: 999px; background: var(--amber); position: relative; transition: background .2s; flex: none; }
  .sqli .toggle .knob { position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: #fff; transition: left .2s; }
  .sqli .toggle input:checked + .track { background: var(--green); }
  .sqli .toggle input:checked + .track .knob { left: 27px; }
  .sqli .toggle input:focus-visible + .track { outline: 2px solid var(--green-dark); outline-offset: 2px; }
  .sqli .toggle .state { color: var(--amber); }
  .sqli .toggle.on .state { color: var(--green); }
  .sqli .toggle .how { background: var(--soft); padding: 4px 8px; border-radius: 6px; font-size: 12px; color: var(--muted); }
  @media (max-width: 700px) { .sqli .routes, .sqli .fields { grid-template-columns: 1fr; } }
</style>
