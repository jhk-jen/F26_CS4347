<%- include('partials/header', { title, navActive: '' }) %>

<main class="product-page" style="max-width:860px;margin:0 auto;padding:32px 16px">
  <%- include('partials/flash') %>

  <h1 style="font-size:28px;margin-bottom:24px">My Account</h1>

  <!-- ── Profile form ───────────────────────────────────────── -->
  <section style="background:var(--surface);border-radius:var(--radius);padding:24px;margin-bottom:32px">
    <h2 style="font-size:18px;margin-bottom:16px">Profile</h2>

    <% if (errors.length) { %>
      <ul class="error-list" style="margin-bottom:16px">
        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form action="/account" method="post">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <label style="display:grid;gap:4px;font-size:14px;color:var(--muted)">
          Full Name *
          <input type="text" name="user_name" value="<%= profileUser.user_name %>"
                 required maxlength="100" style="padding:10px 12px;border:1px solid var(--line);border-radius:8px">
        </label>
        <label style="display:grid;gap:4px;font-size:14px;color:var(--muted)">
          Email (read-only)
          <input type="email" value="<%= profileUser.email %>" disabled
                 style="padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--muted)">
        </label>
        <label style="display:grid;gap:4px;font-size:14px;color:var(--muted)">
          Phone Number
          <input type="text" name="phone_no" value="<%= profileUser.phone_no || '' %>"
                 maxlength="20" style="padding:10px 12px;border:1px solid var(--line);border-radius:8px">
        </label>
        <label style="display:grid;gap:4px;font-size:14px;color:var(--muted)">
          Role
          <input type="text" value="<%= profileUser.user_type %>" disabled
                 style="padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--muted)">
        </label>
        <label style="display:grid;gap:4px;font-size:14px;color:var(--muted);grid-column:1/-1">
          Address
          <input type="text" name="address" value="<%= profileUser.address || '' %>"
                 maxlength="255" style="padding:10px 12px;border:1px solid var(--line);border-radius:8px">
        </label>
      </div>
      <button class="btn" type="submit" style="margin-top:16px">Save Changes</button>
    </form>
  </section>

  <!-- ── Recent orders ─────────────────────────────────────── -->
  <section style="margin-bottom:32px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:12px">
      <h2 style="font-size:18px">Recent Orders</h2>
      <a href="/orders" style="color:var(--green);font-size:14px">View all →</a>
    </div>
    <% if (!orders.length) { %>
      <p style="color:var(--muted)">No orders yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Order</th><th>Date</th><th>Status</th><th>Items</th><th>Total</th></tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td><a href="/orders/<%= o.order_id %>" style="color:var(--green)">#<%= o.order_id %></a></td>
              <td><%= fmtDate(o.order_date) %></td>
              <td><span class="pill"><%= o.order_status %></span></td>
              <td><%= o.item_count %></td>
              <td>$<%= o.total ? parseFloat(o.total).toFixed(2) : '0.00' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <!-- ── My reviews ────────────────────────────────────────── -->
  <section>
    <h2 style="font-size:18px;margin-bottom:12px">My Reviews</h2>
    <% if (!reviews.length) { %>
      <p style="color:var(--muted)">You haven't written any reviews yet.</p>
    <% } else { %>
      <div style="display:grid;gap:12px">
        <% reviews.forEach(r => { %>
          <div style="background:var(--surface);border-radius:var(--radius);padding:16px">
            <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:4px">
              <a href="/product/<%= r.product_id %>" style="color:var(--green);font-weight:700"><%= r.p_name %></a>
              <span style="color:var(--amber);font-size:18px"><%- stars(r.rating_value) %></span>
            </div>
            <strong style="font-size:14px"><%= r.review_title %></strong>
            <p style="font-size:14px;color:var(--muted);margin:4px 0 0"><%= r.review_str %></p>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
