<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/img/favicon.png">
</head>
<body>

<header class="site-header">
  <a class="logo" href="/">
    <img class="logo-mark" src="/img/logo.png" alt="" width="40" height="40">
    <span>
      <span class="logo-name">Leaf &amp; Brew</span><br>
      <span class="logo-tag">Good tea brighter days</span>
    </span>
  </a>
  <nav class="main-nav">
    <a class="<%= locals.navActive === 'shop' ? 'active' : '' %>" href="/">Shop</a>
  </nav>
  <form class="search" action="/" method="get">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="search" name="q" placeholder="Search tea, flavors, or keywords…" maxlength="100"
           value="<%= locals.query ? locals.query.q || '' : '' %>">
  </form>
  <div class="header-actions">
    <% if (user) { %>
      <a href="/account">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        Hi, <%= user.user_name.split(' ')[0] %>
      </a>
      <a href="/orders">My Orders</a>
      <% if (['Owner','Staff'].includes(user.user_type)) { %>
        <a href="/admin">Admin</a>
      <% } %>
      <a href="/logout">Log Out</a>
    <% } else { %>
      <a href="/login">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        Sign in
      </a>
    <% } %>
    <a class="cart-link" href="/cart">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 4h2l2.4 11h11l2-8H6.2"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
      <span class="cart-badge"><%= cart.items.reduce(function(s,i){return s+i.qty;},0) %></span>
    </a>
  </div>
</header>
