<%- include('partials/header', { title, navActive: '' }) %>
<%- include('partials/flash') %>

<main class="product-page">
  <h1 style="font-size:40px;margin-bottom:24px">Your Cart</h1>

  <% if (cart.items.length === 0) { %>
    <div style="text-align:center;padding:48px 0;color:var(--muted)">
      <p>Your cart is empty.</p>
      <a class="btn" href="/">Browse Teas</a>
    </div>
  <% } else { %>
    <form action="/cart/update" method="post">
      <table>
        <thead>
          <tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr>
        </thead>
        <tbody>
          <% cart.items.forEach(item => { %>
            <tr>
              <td>
                <div class="thumb-cell">
                  <img src="/img/<%= item.img %>.jpg" alt="<%= item.p_name %>">
                  <a href="/product/<%= item.product_id %>"><%= item.p_name %></a>
                </div>
              </td>
              <td>$<%= item.price.toFixed(2) %></td>
              <td>
                <input type="number" name="qty_<%= item.product_id %>"
                       value="<%= item.qty %>" min="1" max="99"
                       style="width:60px;padding:6px;border:1px solid var(--line);border-radius:8px">
              </td>
              <td>$<%= (item.price * item.qty).toFixed(2) %></td>
              <td>
                <button form="remove-<%= item.product_id %>" class="btn"
                  style="background:none;color:var(--muted);padding:4px 10px;font-size:13px">✕</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:20px">
        <button class="btn" type="submit" style="background:var(--soft);color:var(--text)">Update Cart</button>
        <div style="font-family:var(--serif);font-size:28px">
          Total: $<%= cart.total.toFixed(2) %>
        </div>
      </div>
    </form>

    <% cart.items.forEach(item => { %>
      <form id="remove-<%= item.product_id %>" action="/cart/remove" method="post" style="display:none">
        <input type="hidden" name="product_id" value="<%= item.product_id %>">
      </form>
    <% }) %>

    <div style="text-align:right;margin-top:20px">
      <a class="btn btn-lg" href="/checkout">Proceed to Checkout →</a>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
</body>
</html>
