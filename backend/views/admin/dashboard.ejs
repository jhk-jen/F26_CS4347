<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/img/favicon.png">
</head>
<body>
<div class="admin">
  <%- include('../partials/admin-sidebar', { active, user }) %>

  <main class="admin-main">
    <div class="admin-top">
      <div><h1>Dashboard</h1><p>A quick overview of your tea shop.</p></div>
      <div class="avatar">
        <span><%= user.user_name[0].toUpperCase() %></span> <%= user.user_name %>
      </div>
    </div>

    <%- include('../partials/flash') %>

    <section class="stats">
      <div class="stat">
        <div class="stat-icon">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="9" r="2.5"/><path d="M2 20c0-4 3-6 7-6s7 2 7 6zM16 14c3 0 6 1.5 6 5h-5"/></svg>
        </div>
        <div>
          <div class="stat-label">Total Visits</div>
          <div class="stat-value"><%= stats.totalVisits.toLocaleString() %></div>
          <div class="stat-note">All time</div>
        </div>
      </div>
      <div class="stat">
        <div class="stat-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
        </div>
        <div>
          <div class="stat-label">Total Orders</div>
          <div class="stat-value"><%= stats.totalOrders %></div>
        </div>
      </div>
      <div class="stat">
        <div class="stat-icon warn">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/></svg>
        </div>
        <div>
          <div class="stat-label">Low Stock Items</div>
          <div class="stat-value"><%= stats.lowStock %></div>
          <div class="stat-note">stock &lt; 10</div>
        </div>
      </div>
      <div class="stat">
        <div class="stat-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        </div>
        <div>
          <div class="stat-label">Total Users</div>
          <div class="stat-value"><%= stats.totalUsers %></div>
        </div>
      </div>
    </section>

    <section class="panels">

      <!-- Traffic chart -->
      <div class="panel">
        <div class="panel-head">
          <div><h2>User Traffic</h2><p>Daily visits (most recent <%= range %> days of data).</p></div>
          <form action="/admin" method="get">
            <select name="range" aria-label="Date range" onchange="this.form.submit()">
              <% [7,14,30].forEach(n => { %>
                <option value="<%= n %>" <%= range == n ? 'selected' : '' %>>Last <%= n %> days</option>
              <% }) %>
            </select>
          </form>
        </div>
        <svg class="chart" viewBox="0 0 600 220" role="img" aria-label="Traffic line chart">
          <!-- grid lines & y-axis labels -->
          <% for (let i = 0; i <= 4; i++) { %>
            <line stroke="#e7e1d5" x1="40" y1="<%= 10 + i * 45 %>" x2="590" y2="<%= 10 + i * 45 %>"/>
            <text x="32" y="<%= 14 + i * 45 %>" text-anchor="end" font-size="11" fill="#7a776c">
              <%= Math.round(chartMax * (1 - i / 4)) %>
            </text>
          <% } %>
          <% if (chartPts.length > 1) { %>
            <polygon fill="#e6ece0" opacity="0.7"
              points="<%= chartPts[0].x %>,200 <%= chartPts.map(p => p.x+','+p.y).join(' ') %> <%= chartPts[chartPts.length-1].x %>,200"/>
            <polyline fill="none" stroke="#5c7353" stroke-width="2.5"
              points="<%= chartPts.map(p => p.x+','+p.y).join(' ') %>"/>
            <% chartPts.forEach(p => { %>
              <circle cx="<%= p.x %>" cy="<%= p.y %>" r="4" fill="#5c7353"/>
            <% }) %>
            <%
              const step = Math.max(1, Math.floor(chartPts.length / 7));
            %>
            <% chartPts.forEach((p, i) => { %>
              <% if (i % step === 0 || i === chartPts.length - 1) { %>
                <text x="<%= p.x %>" y="212" text-anchor="middle" font-size="11" fill="#7a776c">
                  <%= p.date.slice(5) %>
                </text>
              <% } %>
            <% }) %>
          <% } else { %>
            <text x="300" y="110" text-anchor="middle" fill="#7a776c">No data available for this range</text>
          <% } %>
        </svg>
      </div>

      <!-- Low stock -->
      <div class="panel">
        <div class="panel-head"><div><h2>Low Stock</h2><p>Products with fewer than 10 units.</p></div></div>
        <table>
          <thead><tr><th>Product</th><th>Stock</th><th>Status</th></tr></thead>
          <tbody>
            <% if (lowStockProducts.length === 0) { %>
              <tr><td colspan="3" style="color:var(--muted)">All products well stocked.</td></tr>
            <% } %>
            <% lowStockProducts.forEach(p => { %>
              <tr>
                <td><a href="/admin/products/<%= p.product_id %>/edit" style="color:var(--green)"><%= p.p_name %></a></td>
                <td><%= p.stock_qty %></td>
                <td><span class="pill warn">Low Stock</span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <div class="panel-foot"><a class="link-arrow" href="/admin/products">Manage products →</a></div>
      </div>

      <!-- Recent orders -->
      <div class="panel">
        <div class="panel-head"><div><h2>Recent Orders</h2><p>Latest orders.</p></div></div>
        <table>
          <thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th></tr></thead>
          <tbody>
            <% recentOrders.forEach(o => { %>
              <tr>
                <td><a href="/admin/orders/<%= o.order_id %>" style="color:var(--green)">#<%= o.order_id %></a></td>
                <td><%= o.user_name %></td>
                <td><span class="pill <%= o.order_status==='Pending'||o.order_status==='Cancelled' ? 'warn' : '' %>"><%= o.order_status %></span></td>
                <td>$<%= o.total ? parseFloat(o.total).toFixed(2) : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <div class="panel-foot"><a class="link-arrow" href="/admin/orders">View all orders →</a></div>
      </div>

    </section>
  </main>
</div>
</body>
</html>
