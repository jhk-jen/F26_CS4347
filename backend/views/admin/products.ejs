<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/img/favicon.png">
</head>
<body>
<div class="admin">
  <%- include('../partials/admin-sidebar', { active, user }) %>
  <main class="admin-main">
    <%- include('../partials/admin-bar', { user }) %>
    <div class="admin-top">
      <div><h1>Products</h1><p>Manage your tea catalogue.</p></div>
      <form class="search" action="/admin/products" method="get">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="q" value="<%= q %>" placeholder="Search products…" maxlength="100">
      </form>
      <a class="btn" href="/admin/products/new">+ New Product</a>
    </div>

    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
        <span><%= flash.msg %></span>
        <% if (flash.zeroStockId) { %>
          <form action="/admin/products/<%= flash.zeroStockId %>/zero-stock" method="post" style="margin:0">
            <button class="btn" style="font-size:13px;padding:5px 14px;background:var(--amber)">Set Stock to 0</button>
          </form>
        <% } %>
      </div>
    <% } %>

    <table>
      <thead><tr><th>ID</th><th>Image</th><th>Name</th><th>Type</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr>
            <td><%= p.product_id %></td>
            <td><img src="/img/<%= p.img %>.jpg" alt="" style="width:48px;height:34px;object-fit:cover;border-radius:6px"></td>
            <td><strong><%= p.p_name %></strong></td>
            <td><%= p.tea_type %></td>
            <td>$<%= parseFloat(p.price).toFixed(2) %></td>
            <td>
              <span class="pill <%= p.stock_qty < 10 ? 'warn' : '' %>"><%= p.stock_qty %></span>
            </td>
            <td style="white-space:nowrap">
              <a href="/admin/products/<%= p.product_id %>/edit" class="btn" style="font-size:13px;padding:5px 14px">Edit</a>
              <form action="/admin/products/<%= p.product_id %>/delete" method="post" style="display:inline"
                    data-confirm="Delete <%= p.p_name %>? This cannot be undone."
                    onsubmit="return confirm(this.dataset.confirm)">
                <button class="btn" style="background:var(--amber);font-size:13px;padding:5px 14px">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</div>
</body>
</html>
