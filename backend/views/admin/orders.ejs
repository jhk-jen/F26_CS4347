<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/img/favicon.png">
</head>
<body>
<div class="admin">
  <%- include('../partials/admin-sidebar', { active, user }) %>
  <main class="admin-main">
    <div class="admin-top">
      <div><h1>Orders</h1><p>All customer orders.</p></div>
      <form action="/admin/orders" method="get" style="display:flex;gap:10px;align-items:center">
        <select name="status" aria-label="Filter by status" onchange="this.form.submit()"
          style="padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:#fff">
          <option value="">All Statuses</option>
          <% statuses.forEach(s => { %>
            <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </form>
    </div>

    <%- include('../partials/flash') %>

    <table>
      <thead><tr><th>Order</th><th>Customer</th><th>Email</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td><strong>#<%= o.order_id %></strong></td>
            <td><%= o.user_name %></td>
            <td class="email"><%= o.email %></td>
            <td><%= fmtDate(o.order_date) %></td>
            <td><%= o.item_count || 0 %></td>
            <td>$<%= o.total ? parseFloat(o.total).toFixed(2) : '0.00' %></td>
            <td><span class="pill <%= o.order_status==='Pending'||o.order_status==='Cancelled' ? 'warn' : '' %>"><%= o.order_status %></span></td>
            <td><a href="/admin/orders/<%= o.order_id %>" style="color:var(--green)">View →</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</div>
</body>
</html>
