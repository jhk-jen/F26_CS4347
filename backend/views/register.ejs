<%- include('partials/header', { title, navActive: '' }) %>

<main class="auth-page">
  <div class="auth-card">
    <h1>Create Account</h1>
    <% if (errors.length) { %>
      <ul class="error-list">
        <% errors.forEach(e => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>
    <form action="/register" method="post">
      <% if (typeof next !== 'undefined' && next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
      <label>Full Name *
        <input type="text" name="user_name" value="<%= old.user_name || '' %>"
               placeholder="Jane Doe" required maxlength="100">
      </label>
      <label>Email *
        <input type="email" name="email" value="<%= old.email || '' %>"
               placeholder="you@example.com" required autocomplete="email">
      </label>
      <label>Password * <span style="font-size:12px;color:var(--muted)">(min 6 characters)</span>
        <input type="password" name="password" placeholder="••••••••" required minlength="6" autocomplete="new-password">
      </label>
      <label>Confirm Password *
        <input type="password" name="confirm_password" placeholder="••••••••" required autocomplete="new-password">
      </label>
      <label>Address <span style="font-size:12px;color:var(--muted)">(optional)</span>
        <input type="text" name="address" value="<%= old.address || '' %>" maxlength="255">
      </label>
      <label>Phone <span style="font-size:12px;color:var(--muted)">(optional)</span>
        <input type="tel" name="phone_no" value="<%= old.phone_no || '' %>" maxlength="20">
      </label>
      <button class="btn btn-lg" type="submit" style="width:100%">Create Account</button>
    </form>
    <p style="text-align:center;margin-top:16px;color:var(--muted);font-size:14px">
      Already have an account? <a href="/login<%= (typeof next !== 'undefined' && next) ? '?next=' + encodeURIComponent(next) : '' %>" style="color:var(--green)">Sign in</a>
    </p>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
