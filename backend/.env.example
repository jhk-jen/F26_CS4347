DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=leaf_and_brew

# Secret used to sign the session cookie — change this to any long random string
SESSION_SECRET=change_this_to_a_long_random_string_in_production

PORT=3000

# Read-only MySQL account for the SQL-injection demo (created by db/sqli_user.sql)
SQLI_USER=leaf_sqli
SQLI_PASS=sqli_readonly
